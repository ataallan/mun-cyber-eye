# Mun Cyber Eye — Phase 5 Prototype
# Copy to .env and adjust. Never commit real secrets.
# This file ships with empty credentials. Do not add a known default password.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5055
FLASK_DEBUG=0

# Optional customer site-admin bootstrap. Leave BOTH empty on a fresh install.
# Create the first site admin via Create account (strong password you choose).
# Site admin runs cameras and review — it cannot train models.
# Only set these if you intentionally seed a site admin — never use a published
# default password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
ADMIN_EMAIL=
# Keep env password in sync with the seeded admin row when both are set
ADMIN_SYNC_PASSWORD=1

# Optional second env login (operator role — cameras, alerts, recipients)
# OPERATOR_USERNAME=
# OPERATOR_PASSWORD=
# OPERATOR_EMAIL=

# Mun Cyber / lab only — developer role can train, activate, upload, extract.
# Leave empty on customer installs. Set BOTH username and password on lab
# machines. Never a published default password (do not use operator/changeme).
DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=
DEVELOPER_EMAIL=

# Vision backend: auto | activity | yolo | mock
# auto = Phase 3 activity checkpoint if present, else YOLO, else MOCK
VISION_BACKEND=auto
ACTIVITY_CHECKPOINT=data/checkpoints/activity_demo.joblib
# Console-activated checkpoint wins over ACTIVITY_CHECKPOINT when this file exists
# ACTIVE_CHECKPOINT_FILE=data/active_checkpoint.json
# ACTIVITY_DATA_ROOT=data/activity
# OBJECTS_DATA_ROOT=data/objects
# Optional object inventory: auto = YOLO sidecar when ultralytics is installed;
# otherwise Last run reports objects_backend=unavailable (nothing invented).
# OBJECTS_BACKEND=auto
# CHECKPOINTS_DIR=data/checkpoints
# 0 = game_or_play and dance are log/predict only (default). 1 = also create alerts.
ALERT_ON_GAME_OR_DANCE=0
# 0 = intense sport (high aggression + named sport_context) stays log-only.
# 1 = queue an info/threat alert so operators can review possible intense play.
ALERT_ON_INTENSE_SPORT=0
# 0 = do not analyze faces (default). 1 = lab-only assistive geometric proxy.
# Never identity, demographics, or criminal labels. Cues are unreliable.
ENABLE_FACE_AGGRESSION=0
# 0 = do not run a gunshot audio side-channel (default). The stub never
# invents a bang; video proxies are separate and weak.
ENABLE_GUNSHOT_AUDIO=0

# Frame sampling
SAMPLE_FPS=2
MAX_FRAMES_PER_RUN=120

# SQLite paths (relative to project root)
ALERT_DB_PATH=data/alerts.db
AUTH_DB_PATH=data/auth.db
CAMERA_DB_PATH=data/cameras.db
SNAPSHOT_DIR=data/snapshots
UPLOAD_DIR=data/uploads

# Authorized source label shown in UI (fallback when not running a registry camera)
DEFAULT_CAMERA_LABEL=Authorized Camera — Demo Lab
DEFAULT_LOCATION_LABEL=Demo Lab
DEFAULT_CAMERA_ID=demo-cam-01

# ---------------------------------------------------------------------------
# Phase 5 — live / multi-camera ingest (authorized feeds only)
# Register cameras in the console (/cameras). Detection runs from those
# cameras when the pipeline runs. Video file uploads are for training only.
# Do not point RTSP or webcam ingest at unauthorized streams. Offline cameras
# and missing credentials are reported on the camera row — the pipeline will
# not invent detections.
# ---------------------------------------------------------------------------
# 0 = refuse webcam capture with a clear error (prototype default)
ALLOW_WEBCAM=0
# OpenCV / thread timeout when opening an RTSP URL
RTSP_CONNECT_TIMEOUT_SEC=8
# Optional env secret for the seeded, disabled RTSP stub (demo-rtsp-01)
# Example: rtsp://user:pass@authorized-nvr.example/stream
RTSP_DEMO_URI=

# Password reset (uses the same optional Resend key as alert delivery)
PUBLIC_BASE_URL=http://127.0.0.1:5055
RESET_TOKEN_MINUTES=45
# Show the one-time reset URL on the forgot-password page (local demo only)
AUTH_SHOW_RESET_URL=0

# Standalone Windows launcher sets this so run.py opens the browser
# MUN_OPEN_BROWSER=0

# ---------------------------------------------------------------------------
# Phase 4 — outbound notification (optional)
# Console/in-app review is always primary. Email and webhook are delivery
# channels. If RESEND_API_KEY is empty, alerts are marked queued/undelivered
# and the app does not crash or invent a successful send.
#
# Camera owners get alerts via each linked account's security_email, then
# that account's login email. You do not need to put personal inboxes here.
# ---------------------------------------------------------------------------

# Resend (https://resend.com). From address must be on a verified domain.
# Leave empty unless you have a verified sending domain.
RESEND_API_KEY=
RESEND_FROM=Mun Cyber Technologies <info@muncyber.com>

# Optional extras only (merged with Recipients directory). Leave empty unless
# you have a site list. Do not put a personal Gmail here.
ALERT_EMAIL_RECIPIENTS=

# Optional site-wide fallback. Used only when no camera-linked account and
# no signed-in session user contributed an address. Default empty.
SECURITY_ALERT_EMAIL=

# Optional SIEM/SOAR webhook (JSON POST of the structured alert)
ALERT_WEBHOOK_URL=
# Optional bearer token sent as Authorization: Bearer …
ALERT_WEBHOOK_SECRET=

# 1 = attempt outbound delivery when a pipeline alert is created
ALERT_NOTIFY_ON_CREATE=1
ALERT_NOTIFY_MAX_ATTEMPTS=3
