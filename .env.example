# Mun Cyber Eye — Phase 2 Prototype
# Copy to .env and adjust. Never commit real secrets.

FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_HOST=127.0.0.1
FLASK_PORT=5055
FLASK_DEBUG=0

# Session auth (demo credentials — change in any real deployment)
ADMIN_USERNAME=operator
ADMIN_PASSWORD=changeme

# Vision backend: auto | yolo | mock
# auto = try ultralytics YOLO, else MOCK
VISION_BACKEND=auto

# Frame sampling
SAMPLE_FPS=2
MAX_FRAMES_PER_RUN=120

# SQLite paths (relative to project root)
ALERT_DB_PATH=data/alerts.db
SNAPSHOT_DIR=data/snapshots

# Authorized source label shown in UI
DEFAULT_CAMERA_LABEL=Authorized Camera — Demo Lab
